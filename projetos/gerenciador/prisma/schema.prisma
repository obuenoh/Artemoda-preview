// Gerenciador Arte e Moda — Fase 1 + Vendas/Nota Fiscal (v2)
//
// PORTABILIDADE: roda em SQLite agora (zero setup na maquina dela) e porta
// para Postgres trocando o provider. Por isso, deliberadamente:
//   - nenhum `enum` do Prisma (SQLite nao suporta) — String + uniao em TS
//   - dinheiro em Int de CENTAVOS
//   - quantidade de materia-prima em Int de MILESIMOS (1,5 m = 1500)
//   - quantidade de produto acabado em Int de UNIDADES (peca nao e fracionaria)
// Nenhum float em lugar nenhum.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────── empresa, gente e auditoria

model Empresa {
  id       String   @id @default(cuid())
  nome     String
  cnpj     String?
  // TODO: confirmar com o contador. Ate la nao dispara nenhuma regra fiscal.
  regime   String? // simples | mei | lucro_presumido
  criadoEm DateTime @default(now())

  usuarios          Usuario[]
  fornecedores      Fornecedor[]
  tiposProduto      TipoProduto[]
  materiasPrimas    MateriaPrima[]
  clientes          Cliente[]
  compras           Compra[]
  movimentos        MovimentoEstoque[]
  inventarios       Inventario[]
  produtosAcabados  ProdutoAcabado[]
  movimentosProduto MovimentoProdutoAcabado[]
  enviosPecas       EnvioPecas[]
  vendas            Venda[]
  lancamentosCaixa  LancamentoCaixa[]
  contasPagar       ContaPagar[]
  contasReceber     ContaReceber[]
  notasFiscais      NotaFiscal[]
  auditoria         Auditoria[]
}

model Usuario {
  id        String   @id @default(cuid())
  empresaId String
  nome      String
  email     String   @unique
  senhaHash String
  papel     String // dona | producao | vendas
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  empresa   Empresa     @relation(fields: [empresaId], references: [id])
  sessoes   Sessao[]
  auditoria Auditoria[]

  @@index([empresaId])
}

model Sessao {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId String
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

/// Quem fez, o que, quando. Nunca sobrescrito.
model Auditoria {
  id         String   @id @default(cuid())
  empresaId  String
  usuarioId  String?
  entidade   String
  entidadeId String
  acao       String // criou | alterou | ajustou | anulou
  resumo     String
  criadoEm   DateTime @default(now())

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, criadoEm])
  @@index([entidade, entidadeId])
}

// ────────────────────────────────────────────────────────────── cadastros

/// Categoria de item de estoque de materia-prima: Tecido, Etiqueta, Ziper...
/// Lista aberta — a dona cria um tipo novo quando precisar, sem depender
/// de mudanca de codigo.
model TipoProduto {
  id                  String   @id @default(cuid())
  empresaId           String
  nome                String
  unidadePadrao       String   @default("unidade") // metro | kg | unidade
  /// So o tipo "Tecido" (semeado) liga os campos extras (composicao,
  /// largura, gramatura) no formulario de cadastro.
  mostrarCamposTecido Boolean  @default(false)
  criadoEm            DateTime @default(now())

  empresa        Empresa        @relation(fields: [empresaId], references: [id])
  materiasPrimas MateriaPrima[]

  @@index([empresaId])
}

model Fornecedor {
  id                String   @id @default(cuid())
  empresaId         String
  nome              String
  cnpj              String?
  contato           String?
  whatsapp          String?
  /// Lista separada por virgula: tecido,aviamento,dtf,silk,bordado,servico,outro
  tipos             String
  condicaoPagamento String   @default("a_vista") // a_vista | 30 | 30_60
  prazoMedioDias    Int      @default(0)
  observacoes       String?
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now())

  empresa      Empresa       @relation(fields: [empresaId], references: [id])
  tabelasPreco TabelaPreco[]
  compras      Compra[]
  contasPagar  ContaPagar[]

  @@index([empresaId])
}

/// Versionada: uma tabela por vigencia. vigenciaFim null = tabela vigente.
/// Nunca se edita preco antigo — cria-se nova vigencia. E assim que ela ve
/// "esse fornecedor subiu 12% desde a ultima compra".
model TabelaPreco {
  id             String    @id @default(cuid())
  fornecedorId   String
  vigenciaInicio DateTime
  vigenciaFim    DateTime?
  observacoes    String?
  criadoEm       DateTime  @default(now())

  fornecedor Fornecedor        @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  itens      TabelaPrecoItem[]

  @@index([fornecedorId, vigenciaInicio])
}

model TabelaPrecoItem {
  id             String  @id @default(cuid())
  tabelaPrecoId  String
  /// materia_prima  → preco por unidade de compra do artigo
  /// servico        → preco por peca do servico (bordado, DTF, silk)
  tipo           String
  materiaPrimaId String?
  tipoServico    String? // bordado | dtf | silk | outro
  descricao      String
  unidade        String // metro | kg | peca
  precoCentavos  Int

  tabelaPreco  TabelaPreco   @relation(fields: [tabelaPrecoId], references: [id], onDelete: Cascade)
  materiaPrima MateriaPrima? @relation(fields: [materiaPrimaId], references: [id])

  @@index([tabelaPrecoId])
  @@index([materiaPrimaId])
}

model MateriaPrima {
  id                String   @id @default(cuid())
  empresaId         String
  tipoProdutoId     String
  nome              String
  composicao        String?
  cor               String?
  larguraMil        Int? // metros x1000
  gramaturaGm2      Int?
  unidade           String   @default("metro") // metro | kg | unidade
  /// TODO(cliente): se ela comprar em kg e consumir em metro, este fator
  /// converte. 1000 = 1 para 1. So e usado quando as unidades diferem.
  fatorConversaoMil Int      @default(1000)
  estoqueMinimoMil  Int      @default(0)
  localizacao       String?
  /// Retalho: de qual tecido cadastrado ele sobrou. Vazio em tecido inteiro
  /// e em retalho de tecido que nunca foi cadastrado.
  retalhoDeId       String?
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now())

  empresa         Empresa            @relation(fields: [empresaId], references: [id])
  tipoProduto     TipoProduto        @relation(fields: [tipoProdutoId], references: [id])
  retalhoDe       MateriaPrima?      @relation("Retalhos", fields: [retalhoDeId], references: [id])
  retalhos        MateriaPrima[]     @relation("Retalhos")
  movimentos      MovimentoEstoque[]
  itensCompra     CompraItem[]
  precos          TabelaPrecoItem[]
  itensInventario InventarioItem[]

  @@index([empresaId])
  @@index([tipoProdutoId])
}

model Cliente {
  id                String   @id @default(cuid())
  empresaId         String
  tipo              String // escola | empresa | marca
  nome              String
  cnpj              String?
  contato           String?
  whatsapp          String?
  condicaoPagamento String   @default("a_vista")
  observacoes       String?
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now())

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  vendas        Venda[]
  notasFiscais  NotaFiscal[]
  contasReceber ContaReceber[]

  @@index([empresaId])
}

// ───────────────────────────────────────────────────────────────── compras

model Compra {
  id                   String   @id @default(cuid())
  empresaId            String
  fornecedorId         String
  numeroNf             String?
  data                 DateTime
  freteCentavos        Int      @default(0)
  outrosCustosCentavos Int      @default(0)
  observacoes          String?
  criadoEm             DateTime @default(now())

  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  fornecedor  Fornecedor   @relation(fields: [fornecedorId], references: [id])
  itens       CompraItem[]
  contasPagar ContaPagar[]

  @@index([empresaId, data])
}

model CompraItem {
  id                    String @id @default(cuid())
  compraId              String
  materiaPrimaId        String
  quantidadeMil         Int
  valorUnitarioCentavos Int
  /// Rateio do frete e outros custos, calculado pelo sistema (por valor).
  /// Ela nunca digita isto — regra "nao pedir o que da para calcular".
  rateioCentavos        Int    @default(0)

  compra       Compra       @relation(fields: [compraId], references: [id], onDelete: Cascade)
  materiaPrima MateriaPrima @relation(fields: [materiaPrimaId], references: [id])

  @@index([compraId])
}

// ─────────────────────────────────────── estoque de materia-prima: IMUTAVEL

/// A unica fonte de verdade do estoque de materia-prima. Saldo = SUM(quantidadeMil).
/// Nunca se faz UPDATE aqui. Correcao entra como novo lancamento de ajuste
/// com motivo e autor. Sem isso, o dia em que os numeros nao baterem nao
/// tem como descobrir por que.
model MovimentoEstoque {
  id                     String   @id @default(cuid())
  empresaId              String
  materiaPrimaId         String
  /// entrada_compra | entrada_inicial | saida_producao | ajuste_inventario
  /// | devolucao_fornecedor | perda
  tipo                   String
  /// Positivo entra, negativo sai. Sempre com sinal.
  quantidadeMil          Int
  custoUnitarioCentavos  Int
  /// Custo medio ponderado APOS este lancamento. Congelado aqui para o
  /// historico ser auditavel e a consulta barata.
  custoMedioAposCentavos Int
  /// Saldo APOS este lancamento — permite ler o extrato sem recalcular.
  saldoAposMil           Int
  origemTipo             String? // compra | inventario | manual
  origemId               String?
  motivo                 String?
  usuarioId              String?
  criadoEm               DateTime @default(now())

  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  materiaPrima MateriaPrima @relation(fields: [materiaPrimaId], references: [id])

  @@index([empresaId, materiaPrimaId, criadoEm])
}

model Inventario {
  id          String   @id @default(cuid())
  empresaId   String
  data        DateTime
  /// aberto | aplicado
  status      String   @default("aberto")
  /// Inventario de abertura: como comecar com o tecido que ja esta na
  /// prateleira, sem nota de compra.
  abertura    Boolean  @default(false)
  observacoes String?
  criadoEm    DateTime @default(now())

  empresa Empresa          @relation(fields: [empresaId], references: [id])
  itens   InventarioItem[]

  @@index([empresaId])
}

model InventarioItem {
  id                    String  @id @default(cuid())
  inventarioId          String
  materiaPrimaId        String
  saldoSistemaMil       Int
  contagemFisicaMil     Int
  /// Obrigatorio quando ha diferenca: sem motivo o ajuste nao entra.
  motivo                String?
  /// Usado so no inventario de abertura, onde nao existe custo historico.
  custoEstimadoCentavos Int?

  inventario   Inventario   @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  materiaPrima MateriaPrima @relation(fields: [materiaPrimaId], references: [id])

  @@index([inventarioId])
}

// ───────────────────────────────────────── produto acabado (peca da loja)

/// O que fica pronto na loja para vender no balcao: uniformes por
/// tamanho/cor, cada um com um SKU/codigo de barras proprio.
model ProdutoAcabado {
  id                 String   @id @default(cuid())
  empresaId          String
  nome               String
  tamanho            String?
  cor                String?
  /// Codigo que a leitora bipa, ou digitado a mao no balcao.
  sku                String
  precoVendaCentavos Int
  custoCentavos      Int      @default(0)
  estoqueMinimo      Int      @default(0)
  ativo              Boolean  @default(true)
  criadoEm           DateTime @default(now())

  empresa    Empresa                   @relation(fields: [empresaId], references: [id])
  movimentos MovimentoProdutoAcabado[]
  itensVenda VendaItem[]

  @@unique([empresaId, sku])
  @@index([empresaId])
}

/// Mesmo principio do estoque de tecido: nunca UPDATE, saldo e soma.
/// Peca nao e fracionaria — quantidade em unidades inteiras, sem milesimos.
/// O saldo e POR FRENTE: a mesma peca tem estoque na Fabrica, na Loja e no
/// E-commerce. Toda peca nasce na Fabrica (entrada_producao) e chega as
/// outras frentes por envio (envio_saida + envio_entrada, mesmo origemId).
model MovimentoProdutoAcabado {
  id                    String   @id @default(cuid())
  empresaId             String
  produtoAcabadoId      String
  /// fabrica | loja | ecommerce (src/lib/frentes.ts)
  frente                String   @default("loja")
  /// entrada_producao | saida_venda | envio_saida | envio_entrada | ajuste_inventario | perda
  tipo                  String
  quantidade            Int // com sinal: positivo entra, negativo sai
  custoUnitarioCentavos Int
  saldoAposUnidades     Int
  origemTipo            String? // venda | manual
  origemId              String?
  motivo                String?
  usuarioId             String?
  criadoEm              DateTime @default(now())

  empresa        Empresa        @relation(fields: [empresaId], references: [id])
  produtoAcabado ProdutoAcabado @relation(fields: [produtoAcabadoId], references: [id])

  @@index([empresaId, produtoAcabadoId, criadoEm])
  @@index([empresaId, produtoAcabadoId, frente, criadoEm])
}

/// Peca que saiu de uma frente para outra (quase sempre Fabrica -> Loja
/// ou E-commerce). Nao e venda: o dinheiro nao saiu da empresa. Os
/// movimentos do envio apontam para ca por origemTipo "envio".
model EnvioPecas {
  id          String   @id @default(cuid())
  empresaId   String
  de          String
  para        String
  observacoes String?
  usuarioId   String?
  criadoEm    DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, criadoEm])
}

// ──────────────────────────────────────────────────────────────── vendas

model Venda {
  id               String   @id @default(cuid())
  empresaId        String
  clienteId        String?
  /// fabrica (pedido fechado para escola, empresa ou marca) | loja (balcao,
  /// com ou sem cliente) | ecommerce (Mercado Livre, lancado a mao)
  frente           String
  formaPagamento   String   @default("dinheiro") // dinheiro | pix | cartao | fiado | mercado_livre
  totalCentavos    Int
  descontoCentavos Int      @default(0)
  observacoes      String?
  usuarioId        String?
  criadoEm         DateTime @default(now())

  empresa       Empresa           @relation(fields: [empresaId], references: [id])
  cliente       Cliente?          @relation(fields: [clienteId], references: [id])
  itens         VendaItem[]
  notasFiscais  NotaFiscalVenda[]
  contasReceber ContaReceber[]

  @@index([empresaId, criadoEm])
  @@index([clienteId])
}

model VendaItem {
  id                    String @id @default(cuid())
  vendaId               String
  produtoAcabadoId      String
  quantidade            Int
  precoUnitarioCentavos Int

  venda          Venda          @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoAcabado ProdutoAcabado @relation(fields: [produtoAcabadoId], references: [id])

  @@index([vendaId])
}

// ─────────────────────────────────────────────────── financeiro: caixa

/// O caixa e o mesmo principio do estoque: saldo = soma dos lancamentos,
/// nunca um campo. Nada aqui e editado ou apagado — erro se corrige com
/// lancamento novo (estorno ou ajuste) com motivo. Toda escrita passa por
/// lancarCaixa() em src/lib/financeiro.ts.
model LancamentoCaixa {
  id            String   @id @default(cuid())
  empresaId     String
  tipo          String // entrada | saida
  /// venda | conta_pagar | conta_receber | manual | abertura | ajuste | estorno
  origemTipo    String?
  origemId      String?
  /// Sempre positivo: o `tipo` diz para que lado vai.
  valorCentavos Int
  descricao     String
  /// Mesma lista de src/lib/financeiro.ts. Vazio em venda, abertura e ajuste.
  categoria     String?
  /// De qual frente veio o dinheiro (venda e recebimento de venda). Vazio
  /// no que e da empresa toda, como aluguel e abertura.
  frente        String?
  data          DateTime @default(now())
  usuarioId     String?
  criadoEm      DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, data])
}

/// O que a confeccao deve e quando vence. A conta so guarda a situacao:
/// quem mexe no dinheiro e o lancamento de caixa criado ao pagar.
/// Cancelar exige motivo e nao apaga nada.
model ContaPagar {
  id                 String    @id @default(cuid())
  empresaId          String
  descricao          String
  categoria          String
  fornecedorId       String?
  compraId           String?
  /// Parcelas da mesma conta (ou meses da mesma conta fixa) dividem o grupo.
  grupoId            String?
  parcela            Int       @default(1)
  totalParcelas      Int       @default(1)
  /// Conta fixa do mes (aluguel, luz): mostrada como "todo mes", nao "1 de 12".
  fixaMensal         Boolean   @default(false)
  valorCentavos      Int
  /// Gravado ao meio-dia local: data sem hora nao pode virar o dia anterior.
  vencimento         DateTime
  situacao           String    @default("aberta") // aberta | paga | cancelada
  pagoEm             DateTime?
  valorPagoCentavos  Int?
  formaPagamento     String?
  motivoCancelamento String?
  observacoes        String?
  usuarioId          String?
  criadoEm           DateTime  @default(now())

  empresa    Empresa     @relation(fields: [empresaId], references: [id])
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id])
  compra     Compra?     @relation(fields: [compraId], references: [id])

  @@index([empresaId, situacao, vencimento])
  @@index([grupoId])
}

/// O que entra depois: venda fiado (criada sozinha na venda) e combinado
/// com cliente, como sinal e restante na entrega. Mesmas regras da conta
/// a pagar.
model ContaReceber {
  id                    String    @id @default(cuid())
  empresaId             String
  descricao             String
  clienteId             String?
  vendaId               String?
  /// Frente da venda que gerou a conta; vai para o caixa quando receber.
  frente                String?
  grupoId               String?
  parcela               Int       @default(1)
  totalParcelas         Int       @default(1)
  valorCentavos         Int
  vencimento            DateTime
  situacao              String    @default("aberta") // aberta | recebida | cancelada
  recebidoEm            DateTime?
  valorRecebidoCentavos Int?
  formaPagamento        String?
  motivoCancelamento    String?
  observacoes           String?
  usuarioId             String?
  criadoEm              DateTime  @default(now())

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  cliente Cliente? @relation(fields: [clienteId], references: [id])
  venda   Venda?   @relation(fields: [vendaId], references: [id])

  @@index([empresaId, situacao, vencimento])
  @@index([grupoId])
}

// ────────────────────────────────────────────────────────────── nota fiscal

/// Ainda em rascunho de proposito: falta definicao do contador (regime,
/// CFOP, certificado). Este registro deixa pronta a tela e o calculo —
/// emissao real exige integrar um provedor homologado (nunca falar
/// direto com a SEFAZ). Ate la, status fica sempre "rascunho".
model NotaFiscal {
  id                       String   @id @default(cuid())
  empresaId                String
  clienteId                String?
  periodoInicio            DateTime
  periodoFim               DateTime
  totalVendasCentavos      Int
  descontoPercentualCem    Int      @default(0) // x100: 1050 = 10,50%
  descontoValorCentavos    Int      @default(0)
  totalComDescontoCentavos Int
  status                   String   @default("rascunho") // rascunho | emitida
  observacoes              String?
  usuarioId                String?
  criadoEm                 DateTime @default(now())

  empresa Empresa           @relation(fields: [empresaId], references: [id])
  cliente Cliente?          @relation(fields: [clienteId], references: [id])
  vendas  NotaFiscalVenda[]

  @@index([empresaId, criadoEm])
}

model NotaFiscalVenda {
  id           String @id @default(cuid())
  notaFiscalId String
  vendaId      String

  notaFiscal NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  venda      Venda      @relation(fields: [vendaId], references: [id])

  @@unique([notaFiscalId, vendaId])
}

/// Configuracoes que dependem de resposta dela ou do contador.
/// Ficam aqui como dado, nunca chumbadas no codigo.
model Configuracao {
  chave     String   @id
  valor     String
  descricao String
  pendente  Boolean  @default(false)
  criadoEm  DateTime @default(now())
}
